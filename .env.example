# Server
# Locally, pick any free port. On Render, PORT is injected automatically at
# runtime and overrides this - you don't need to set it in the dashboard.
PORT=5000
NODE_ENV=development

# MongoDB - locally this can point at a local mongod. On Render, use a hosted
# cluster's connection string (e.g. MongoDB Atlas), since Render does not host
# MongoDB itself. Whitelist 0.0.0.0/0 in Atlas's Network Access (or Render's
# specific outbound IPs on paid plans) so Render can reach it.
MONGO_URI=mongodb://127.0.0.1:27017/telemed

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - the URL(s) your frontend runs on (comma separated, no trailing slash).
# On Render, set this to your deployed frontend's URL, e.g.
# https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: AI Health Assistant (proxied through /api/ai-chat)
# If left blank, the endpoint returns a canned/rule-based response instead of calling a real model.
ANTHROPIC_API_KEY=

# Paystack (required for paid subscription upgrades)
# Get these from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override - defaults to the first CLIENT_URL entry + /subscription/callback
PAYSTACK_CALLBACK_URL=

# Admin bootstrap - on every server start these accounts are created (or
# promoted) as admins. sam.ola13@gmail.com is always included in code.
# INITIAL_ADMIN_PASSWORD is used only when an account has to be created; if
# it's blank, a random password is generated and printed once in the server log.
INITIAL_ADMIN_EMAILS=
INITIAL_ADMIN_PASSWORD=

# Public URL of the deployed frontend. Used to build links inside emails
# (e.g. "Sign In", "Review Application" buttons).
FRONTEND_URL=http://localhost:5173

# Email delivery (transactional emails: welcome messages, appointment and
# consultation updates, prescriptions, doctor approval/rejection, password
# changes, payment receipts, and admin/doctor account credentials). Works
# with any SMTP provider (Gmail with an app password, SendGrid SMTP, Mailgun
# SMTP, etc). If EMAIL_USER/EMAIL_PASSWORD are left blank, sending fails
# quietly (logged to the server console) and the rest of the app keeps
# working normally - emails are always best-effort, never required.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=TeleMed <noreply@telemed.example>
